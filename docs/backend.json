
{
  "entities": {
    "DocumentMetadata": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "DocumentMetadata",
      "type": "object",
      "description": "Metadata for a creed, confession, or catechism.",
      "properties": {
        "id": { "type": "string" },
        "title_te": { "type": "string", "description": "Telugu title" },
        "title_en": { "type": "string", "description": "English title" },
        "year": { "type": "number" },
        "category": { 
          "type": "string", 
          "enum": ["Ecumenical", "Reformed", "Baptist", "Lutheran", "Other"] 
        },
        "type": { 
          "type": "string", 
          "enum": ["catechism", "confession"] 
        }
      },
      "required": ["id", "title_te", "category", "type"]
    },
    "DocumentContent": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "DocumentContent",
      "type": "object",
      "description": "The actual content of a document, organized by sections.",
      "properties": {
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": { "type": "string" },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "number": { "type": "number" },
                    "title": { "type": "string" },
                    "question": { "type": "string" },
                    "answer": { "type": "string" },
                    "content": { "type": "string" },
                    "scripture": { "type": "array", "items": { "type": "string" } }
                  }
                }
              }
            }
          }
        }
      }
    },
    "UserProfile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "UserProfile",
      "type": "object",
      "properties": {
        "favorites": { "type": "array", "items": { "type": "string" } },
        "completedSections": { "type": "array", "items": { "type": "string" } },
        "theme": { "type": "string", "enum": ["light", "dark"] }
      }
    }
  },
  "auth": {
    "providers": ["anonymous"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/documents/{docId}",
        "definition": {
          "entityName": "DocumentMetadata",
          "schema": { "$ref": "#/backend/entities/DocumentMetadata" },
          "description": "Public creeds and catechisms."
        }
      },
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "UserProfile",
          "schema": { "$ref": "#/backend/entities/UserProfile" },
          "description": "User progress and settings."
        }
      }
    ]
  }
}
